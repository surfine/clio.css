{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["ts/**", "tooling/**/*.ts", "packages/**/*.ts", "packages/**/*.tsx"]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noInnerDeclarations": "warn" },
      "suspicious": { "noAssignInExpressions": "warn", "useIterableCallbackReturn": "warn" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/components/**"],
      "linter": { "rules": { "a11y": { "useButtonType": "off" }, "suspicious": { "noArrayIndexKey": "off" } } }
    },
    {
      "includes": ["packages/site/**"],
      "linter": { "rules": { "correctness": { "useJsxKeyInIterable": "off" }, "security": { "noDangerouslySetInnerHtml": "off" }, "suspicious": { "noArrayIndexKey": "off" } } }
    }
  ]
}
