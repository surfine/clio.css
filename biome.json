{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["ts/**", "tooling/**/*.ts"]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noInnerDeclarations": "warn" },
      "suspicious": { "noAssignInExpressions": "warn", "useIterableCallbackReturn": "warn" }
    }
  }
}
