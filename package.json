{
  "name": "clio.css",
  "version": "1.1.1",
  "description": "CSS library for classic Mac OS interfaces: Macintosh System 6, System 7, Mac OS 8.5 Drawing Board and Mac OS 8/9 Platinum windows, menus, buttons, scroll bars and dialogs, with every value traced to measured pixels.",
  "keywords": [
    "css",
    "css-framework",
    "design-system",
    "classic-mac",
    "classic-macos",
    "macintosh",
    "system-6",
    "system-7",
    "mac-os-9",
    "mac-os-8",
    "platinum",
    "drawing-board",
    "appearance-manager",
    "control-strip",
    "retro",
    "vintage",
    "1-bit",
    "chicago",
    "ui",
    "system.css",
    "nextstep"
  ],
  "homepage": "https://surfine.github.io/clio.css/",
  "bugs": {
    "url": "https://github.com/surfine/clio.css/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surfine/clio.css.git"
  },
  "license": "MIT",
  "author": "clio.css contributors",
  "type": "module",
  "main": "dist/clio.css",
  "style": "dist/clio.css",
  "unpkg": "dist/clio.css",
  "jsdelivr": "dist/clio.css",
  "exports": {
    ".": "./dist/clio.css",
    "./system6": "./dist/clio.system6.css",
    "./platinum": "./dist/clio.platinum.css",
    "./min": "./dist/clio.min.css",
    "./system6.min": "./dist/clio.system6.min.css",
    "./platinum.min": "./dist/clio.platinum.min.css",
    "./components.json": "./dist/components.json",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./system7": "./dist/clio.system7.css",
    "./system7.min": "./dist/clio.system7.min.css",
    "./nextstep": "./dist/clio.nextstep.css",
    "./nextstep.min": "./dist/clio.nextstep.min.css",
    "./js": {
      "types": "./dist/clio.d.ts",
      "default": "./dist/clio.js"
    },
    "./js.min": "./dist/clio.min.js",
    "./sounds-panel": "./dist/clio-sounds-panel.js"
  },
  "files": [
    "dist",
    "llms.txt",
    "EVIDENCE.md",
    "THIRD-PARTY.md",
    "AGENTS.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node tooling/build.mjs",
    "test": "node tooling/build.mjs && node test/check.mjs",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check",
    "fidelity": "node tooling/fidelity.mjs",
    "behaviour": "node tooling/build.mjs && node tooling/behaviour.mjs",
    "prepack": "node tooling/build.mjs && node test/check.mjs",
    "capture:system6": "node tooling/capture-system6.mjs",
    "capture:keycaps": "node tooling/capture-keycaps.mjs",
    "build:font": "python3 tooling/extract-glyphs.py --font chicago && python3 tooling/extract-glyphs.py --font geneva && python3 tooling/extract-glyphs.py --font geneva9 && python3 tooling/extract-glyphs.py --font charcoal && python3 tooling/build-font.py clio-sans-84 && python3 tooling/build-font.py clio-text-84 && python3 tooling/build-font.py clio-text-84-9 && python3 tooling/build-font.py clio-sans-97 && python3 tooling/build-font.py clio-sans-97-title && python3 tooling/build-font.py clio-sans-97 --exact && python3 tooling/build-font.py clio-sans-97-title --exact && python3 tooling/build-font.py clio-sans-97 --plain && python3 tooling/build-font.py clio-sans-97-title --plain && python3 tooling/build-font.py clio-sans-97 --plain --exact && python3 tooling/build-font.py clio-sans-97-title --plain --exact && python3 tooling/trace-outline.py",
    "capture:system7": "node tooling/capture-system7.mjs",
    "capture:drawingboard": "node tooling/capture-drawingboard.mjs",
    "capture:platinum": "node tooling/capture-platinum.mjs",
    "capture:charcoal-large": "node tooling/capture-charcoal-large.mjs",
    "capture:charcoal-ui": "node tooling/capture-charcoal-ui.mjs",
    "soundset": "python3 tooling/soundset.py packs",
    "sound-proof": "node tooling/sound-proof.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@preact/preset-vite": "2.10.6",
    "@preact/signals": "2.11.4",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "preact": "11.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
