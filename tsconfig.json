{
  // The Appearance > Sound panel script (dist/clio-sounds-panel.js), written in TypeScript and
  // emitted as a plain, commented, non-module script by tooling/build.ts. clio.js itself is the
  // ES modules checked by tsconfig.runtime.json and bundled by Vite.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "removeComments": false,
    "rootDir": "ts",
    "outDir": ".build",
    "skipLibCheck": true
  },
  "include": ["ts/**/*.ts", "types/**/*.d.ts"]
}
