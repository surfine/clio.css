{
  "name": "clio.css-react",
  "version": "2.0.2",
  "description": "clio.css components for React: one JSX source, rendering clio.css markup (load clio.css and, for behaviour, clio.js).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/components/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/types/components/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "clio.css": ">=2.0.0"
  },
  "sideEffects": false,
  "homepage": "https://surfine.github.io/clio.css/",
  "bugs": {
    "url": "https://github.com/surfine/clio.css/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surfine/clio.css.git",
    "directory": "packages/react"
  },
  "keywords": [
    "clio.css",
    "react",
    "classic mac os",
    "system 6",
    "system 7",
    "mac os 9",
    "platinum",
    "nextstep",
    "components"
  ],
  "scripts": {
    "prepack": "cd ../.. && node tooling/build.ts && node tooling/build-components.ts",
    "prepublishOnly": "node ../../tooling/release-guard.ts --stamp"
  }
}
